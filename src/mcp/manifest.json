{
  "$schema": "https://modelcontextprotocol.io/schema/manifest.json",
  "name": "solana-anchor-devsecops-mcp",
  "displayName": "Solana Anchor DevSecOps, AST & GraphRAG MCP Plugin",
  "version": "1.0.0",
  "contractVersion": "v1",
  "protocolVersion": "2024-11-05",
  "description": "MCP and EGC command catalog generated from the v1 runtime contract.",
  "author": {
    "name": "Solana Anchor DevSecOps Core Team",
    "maintainers": [
      "mrcoantonioconceicao",
      "Felipe Marzock"
    ]
  },
  "runtime": {
    "type": "node",
    "entry": "src/mcp/cli.ts",
    "transport": "stdio",
    "isolation": "local_encrypted_machine_isolation"
  },
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  },
  "tools": [
    {
      "name": "egc_contract_catalog",
      "displayName": "egc contract catalog",
      "description": "Returns the versioned EGC command catalog and JSON Schemas.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "generate_anchor_contract",
      "displayName": "generate anchor contract",
      "description": "Generates an Anchor contract and returns its source, byte sizing, guards, and AST audit preview.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "programName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "accountName": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{1,63}$"
          },
          "pdaPrefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "hasCheckedMath": {
            "type": "boolean"
          },
          "hasSignerCheck": {
            "type": "boolean"
          },
          "includeCloseInstruction": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "audit_rust_ast",
      "displayName": "audit rust ast",
      "description": "Audits supplied Rust/Anchor source and reports rule counts, findings, and account/PDA checks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        },
        "required": [
          "sourceCode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_github_pr",
      "displayName": "create github pr",
      "description": "Creates a GitHub pull request with manual merge only; the PAT is accepted only as input and is never returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "repoName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "branchName": {
            "type": "string",
            "maxLength": 255
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "maxLength": 50000
          },
          "contractCode": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "token",
          "owner",
          "repoName"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "audit_anchor_ast",
      "displayName": "audit anchor ast",
      "description": "Compatibility alias for audit_rust_ast.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        },
        "required": [
          "sourceCode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "run_property_fuzzer",
      "displayName": "run property fuzzer",
      "description": "Runs the local property-based model and reports executed vectors, invariant outcomes, and duration.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "vectorCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "hasCheckedMath": {
            "type": "boolean"
          },
          "hasSignerCheck": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "derive_pda_spec",
      "displayName": "derive pda spec",
      "description": "Derives the PDA address and canonical bump locally; does not quote an RPC rent balance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "authorityPubkey": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
          },
          "seedPrefix": {
            "type": "string",
            "pattern": "^[\\x20-\\x7E]{1,32}$"
          }
        },
        "required": [
          "authorityPubkey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "query_graphrag_security",
      "displayName": "query graphrag security",
      "description": "Returns GraphRAG status, score, community, paths, and graph counts when source is supplied.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "instructionTarget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "sourceCode": {
            "type": "string",
            "maxLength": 200000
          }
        },
        "required": [
          "instructionTarget"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "scan_repository_ast",
      "displayName": "scan repository ast",
      "description": "Scans provided files or the repository and reports measured file/line counts, findings, and Solana guarantees.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                "content": {
                  "type": "string",
                  "maxLength": 1000000
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_github_issues",
      "displayName": "create github issues",
      "description": "Creates GitHub issues from supplied scan findings; the PAT is never included in results.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "repoName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "findings": {
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "ruleId": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "PDA_DERIVATION",
                    "RENT_EXEMPT_MEMORY",
                    "ARITHMETIC_OVERFLOW",
                    "SIGNER_VALIDATION"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "CRITICAL",
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                    "PASS"
                  ]
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "snippet": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "recommendation": {
                  "type": "string"
                },
                "remediationCode": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "ruleId",
                "category",
                "title",
                "severity",
                "file",
                "line",
                "description",
                "recommendation"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "token",
          "owner",
          "repoName"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "execute_egc_one_click",
      "displayName": "execute egc one click",
      "description": "Runs the implemented scan, issue creation, PR dispatch, PDF generation, and state cleanup flow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "repoName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "branchName": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "token",
          "owner",
          "repoName"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "analyze_contextual_architecture",
      "displayName": "analyze contextual architecture",
      "description": "Returns measured GraphRAG, DDD invariant, file, and SOA counts for supplied or repository files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                "content": {
                  "type": "string",
                  "maxLength": 1000000
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "run_anchor_lint",
      "displayName": "run anchor lint",
      "description": "Runs the Anchor static linter over supplied or repository files and returns issue counts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                "content": {
                  "type": "string",
                  "maxLength": 1000000
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "run_security_lint",
      "displayName": "run security lint",
      "description": "Runs the existing Clippy and Web3 security rule model using its active local profile.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                "content": {
                  "type": "string",
                  "maxLength": 1000000
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "egc_clean_state",
      "displayName": "egc clean state",
      "description": "Purges the local EGC session state and returns the actual cleanup result.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "record_batch_audit_receipts",
      "displayName": "record batch audit receipts",
      "description": "Builds a local batch receipt summary. This adapter has no signing-key input and does not submit a Solana transaction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "auditorPubkey": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44,
            "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
          },
          "items": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "targetProgram": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 44,
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
                },
                "auditHash": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "riskLevel": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 0
                    },
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    },
                    {
                      "type": "number",
                      "const": 3
                    },
                    {
                      "type": "number",
                      "const": 4
                    }
                  ]
                },
                "findingsCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "securityScore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "targetProgram",
                "auditHash",
                "riskLevel",
                "findingsCount",
                "securityScore"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "auditorPubkey",
          "items"
        ],
        "additionalProperties": false
      }
    }
  ]
}
